# ========================================================
# UPI Rakshak AI — Environment Configuration Template
# All fields have safe offline defaults. No API keys required.
# ========================================================

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///./data/upi_rakshak.db

# Authentication (Default JWT secret for local evaluation)
JWT_SECRET=replace_with_a_secure_jwt_secret_in_production_2026
ADMIN_EMAIL=admin@upirakshak.ai
# Leave blank to auto-generate a secure random 16-character password on first boot
ADMIN_PASSWORD=

# Risk Engine Thresholds (Configurable)
SAFE_MAX_SCORE=34
SUSPICIOUS_MAX_SCORE=69

# Optional LLM Enhancement (Leave blank for 100% offline deterministic templates)
# GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Threat Intel Lookup (Leave blank for pure static URL analysis)
# GOOGLE_SAFE_BROWSING_KEY=your_key_here
# VIRUSTOTAL_API_KEY=your_key_here

# Optional Channel Bot Configuration
# Telegram Bot (Get token from @BotFather)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token_here

# WhatsApp Bot (Twilio or Meta)
WHATSAPP_PROVIDER=twilio
# Twilio WhatsApp Sandbox
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_WHATSAPP_NUMBER=+14155238886

# Meta WhatsApp Cloud API
# META_WHATSAPP_TOKEN=your_meta_system_user_token_here
# META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
# META_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Optional Voice Speech-To-Text
ENABLE_OFFLINE_STT=false

# Model Experiment Flag (default false: uses fast offline TF-IDF ensemble)
USE_TRANSFORMER_NLP=false
TRANSFORMER_MODEL_PATH=backend/app/data/indic_transformer_model
